# ============ 构建产物 ============
# 本地编译输出（build/ 同时覆盖 verify/build/）
build/
*.class
*.jar

# ============ 运行输出与日志 ============
output/
*.log

# ============ 完整运行结果 ============
# 体积大且可由脚本再生，只提交 results/sample-output.txt
#   results/expected-output.txt 由 scripts/verify-local.sh 生成（约 330 KB / 5368 行）
#   results/part-r-*            由集群运行 scripts/run.sh 后取回
results/expected-output.txt
results/part-r-*

# ============ 实验报告与报告插图 ============
# 报告单独提交，不进代码仓库：报告生成脚本、学院模板、导出的 docx/pdf、报告截图
make_report_docx.py
make_docx_report.py
*.docx
*.pdf
screenshots/

# ============ 本地辅助工具与中间格式 ============
